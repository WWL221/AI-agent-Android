# Server
PORT=8787

# OpenAI-compatible API. The web settings can override base URL/model per request.
OPENAI_API_KEY=
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-4o-mini

# Optional shared secret. When set, the phone app must enter the same token.
AGENT_AUTH_TOKEN=

# Agent workspace used by file tools. Relative paths resolve from this file.
AGENT_WORKSPACE=./server/workspace

# Set to true to try the built-in demo agent without an API key.
AGENT_MOCK=false

# Set to true to allow shell commands with explicit phone-side approval.
AGENT_ALLOW_SHELL=true
