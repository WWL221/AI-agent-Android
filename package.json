{
  "name": "pocket-agent",
  "version": "0.1.2",
  "private": true,
  "description": "A Codex-style AI agent that runs on Android phones via a mobile-first PWA and a local Node agent server.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:all": "npm install && npm --prefix web install",
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node --watch server/index.mjs",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm run build && node server/index.mjs",
    "server": "node server/index.mjs",
    "icons": "python scripts/make_icons.py",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.2"
  }
}
